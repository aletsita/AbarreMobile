{
  "name": "tendero-mobile",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:capas && tsc -b && vite build",
    "check:capas": "node scripts/check-layers.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "cap:sync": "npm run build && npx cap sync android",
    "cap:android": "npm run build && npx cap sync android && npx cap open android",
    "test": "vitest run"
  },
  "dependencies": {
    "@capacitor-mlkit/barcode-scanning": "^8.2.2",
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@fontsource-variable/inter": "^5.1.0",
    "@ionic/react": "^8.4.0",
    "@ionic/react-router": "^8.4.0",
    "@stripe/stripe-js": "10.2.0",
    "capacitor-secure-storage-plugin": "0.13.0",
    "history": "4.10.1",
    "ionicons": "^7.4.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^5.3.4",
    "react-router-dom": "^5.3.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@eslint/js": "^9.39.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-router": "^5.1.20",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
